# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Pinecone Vector DB
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=rag-documents
PINECONE_NAMESPACE=documents

# Redis (Conversational Memory & Rate Limiting)
# When running locally outside Docker: redis://localhost:6379/0
# When running with Docker Compose: redis://redis:6379/0
# Or your Redis Cloud URL: redis://default:password@host:port
REDIS_URL=redis://localhost:6379/0

# Database (SQL)
DATABASE_URL=sqlite:///./rag.db

# Rate Limiting (Requests per minute)
RATE_LIMIT_CHAT_RPM=30
RATE_LIMIT_UPLOAD_RPM=10
